# Maestro secrets / host overrides. Copy to .env and fill in values.
# Never commit .env.

# Discord bot (required)
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Optional multi-home override: guild:channel,guild:channel
# DISCORD_HOMES=
# Legacy fallback only: used when the source guild has no homes[] entry.
# Persist threads normally open under that guild's home channel from homes[].
# DISCORD_THREAD_HOME_CHANNEL_ID=1545493623259398284

# Operator allowlist (Discord user snowflakes). Luipy is always included.
# Comma-separated multi-user override:
# MAESTRO_ALLOWED_USER_IDS=488728568457854976,782038381818937384,687953899566530588
# Legacy single id (merged into the allowlist):
MAESTRO_ALLOWED_USER_ID=

# Optional Discord / NL toggles
# DISCORD_MESSAGE_CONTENT_INTENT=1
# MAESTRO_NL_COMMANDS=1
# MAESTRO_NL_ROUTER_TIMEOUT=180

# cursor-agent binary (default: /root/.local/bin/cursor-agent)
# CURSOR_AGENT_BIN=

# Optional paths
# MAESTRO_CONFIG=/root/bots/maestro/config.json
# MAESTRO_STATE_DIR=/root/bots/maestro/data

# Redmine (MaestroBot notes)
REDMINE_URL=https://redmine.amvara.de
REDMINE_API_KEY=
REDMINE_USER_LOGIN=MaestroBot
# Lost & Found close-note sink when no catalog hub / work ticket
REDMINE_DEFAULT_ISSUE_ID=8077

# OpenCloud Maestro Space hangar
OPENCLOUD_URL=https://cloud.km0digital.com
OPENCLOUD_USER=
OPENCLOUD_PASSWORD=
OPENCLOUD_USER_ID=
OPENCLOUD_SPACE_NAME=
OPENCLOUD_SPACE_ID=
# Prefer app token over password when available
OPENCLOUD_APP_TOKEN=
# OPENCLOUD_APP_TOKEN_EXPIRES_AT=
