      "context": "contexts/amvara-de",
      "aliases": [
        "amvara.de",
        "amvara site",
        "amvara-2.0",
        "amvara website"
      ],
      "active": true,
      "autoagents": {
        "enabled": true,
        "rel_dir": "autoagents",
        "loop": "autoagents-loop.sh"
      }
    },
    {
      "id": "econsultants",
      "kind": "web",
