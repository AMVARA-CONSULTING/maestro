{
  "host": "amvara2",
  "description": "Amvara hub: amvara.de site, GitLab, HAProxy, Sentry, stunnel-redmine (client to amvara3), ops. SSH typically port 60022. Reach with ssh amvara2 (fallback via amvara4).",
  "ssh_alias": "amvara2",
  "projects": [
    {
      "id": "amvara2-ops",
      "kind": "ops",
      "path": "/home/amvara/projects/scripts",
      "summary": "Host maintenance on amvara2: disk/journal alerts, certbot, gitlab version check, backups.",
      "context": "contexts/amvara2-ops",
      "aliases": [
        "amvara2 scripts",
        "amvara 2 ops"
      ],
      "active": true
    },
    {
      "id": "stunnel-redmine",
      "kind": "ops",
      "path": "/home/amvara/projects/stunnel-redmine",
      "summary": "Stunnel Redmine client on amvara2 tunneling to amvara3 Redmine (local Redmine containers disabled).",
      "context": "contexts/stunnel-redmine",
      "aliases": [
        "stunnel redmine",
        "redmine-stunnel",
        "amvara2-stunnel"
      ],
      "active": true
    },
    {
      "id": "amvara-de",
      "kind": "web",
      "path": "/root/work/amvara-2.0",
